menu "DrySpool firmware settings"

config DRYSPOOL_CLOUD
	bool
	default y if BOARD_NRF7002DK_NRF5340_CPUAPP_NS

config APP_VERSION
	string "DrySpool application version"
	default "$(APPVERSION)"

config CLOUD_CONNECTION_RETRY_TIMEOUT_SECONDS
	int "Cloud connection retry timeout (seconds)"
	default 30

config CONNECTION_THREAD_STACK_SIZE
	int "Cloud connection thread stack size (bytes)"
	default 2048

config SENSOR_SAMPLE_INTERVAL_SECONDS
	int "Cloud telemetry interval (seconds)"
	default 60
	help
	  Controls cloud reporting. The local sampling loop runs independently.

if NRF_CLOUD_COAP

config SAMPLE_MEMFAULT_FOTA
	bool "Application FOTA using Memfault Release Management"
	depends on BOOTLOADER_MCUBOOT
	depends on $(dt_nodelabel_enabled,slot1_partition)
	depends on MCUBOOT_BOOTLOADER_MODE_SWAP_USING_OFFSET || MCUBOOT_BOOTLOADER_MODE_SWAP_USING_MOVE || \
			MCUBOOT_BOOTLOADER_MODE_SWAP_SCRATCH || MCUBOOT_BOOTLOADER_MODE_RAM_LOAD_WITH_REVERT || \
			MCUBOOT_BOOTLOADER_MODE_DIRECT_XIP_WITH_REVERT
	help
	  Enables application firmware updates delivered through Memfault
	  Release Management. Requires a MCUboot mode that supports the
	  test/confirm revert mechanism, since the sample relies on
	  boot_write_img_confirmed() to mark an update as good.

config SAMPLE_MEMFAULT_BUTTONS
	bool "Trigger Memfault actions with DK buttons"
	default y
	depends on MEMFAULT
	select DK_LIBRARY
	help
	  Lets the application trigger Memfault actions on demand, instead of
	  waiting for the Memfault SDK's periodic upload timer:
	  The first button (sw0) captures a metrics heartbeat and posts all pending chunks.
	  The second button (sw1) checks for a FOTA update (requires SAMPLE_MEMFAULT_FOTA).

config SAMPLE_MEMFAULT_BUTTONS_THREAD_STACK_SIZE
	int "Memfault buttons thread stack size (bytes)"
	default 4096
	depends on SAMPLE_MEMFAULT_BUTTONS
	help
	  Sets the stack size (in bytes) for the thread that runs the
	  button-triggered Memfault actions.

endif

endmenu

if NRF_CLOUD_MQTT
module-str = MQTT nRF Cloud
endif
if NRF_CLOUD_COAP
module-str = CoAP nRF Cloud
endif
module = WIFI_NRF_CLOUD
source "$(ZEPHYR_BASE)/subsys/logging/Kconfig.template.log_config"

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
