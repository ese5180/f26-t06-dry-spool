config WIFI_NRF70
	default y if BOARD_NRF7002DK_NRF5340_CPUAPP_NS

config PARTITION_MANAGER
	default n

# MCUBoot is not fully supported on nRF7120/ns yet
choice BOOTLOADER
	default BOOTLOADER_MCUBOOT
endchoice

source "share/sysbuild/Kconfig"

config DRYSPOOL_BLE_SETUP
	bool "Build the DrySpool Bluetooth setup profile"
	depends on BOARD_NRF7002DK_NRF5340_CPUAPP_NS

config NRF_DEFAULT_IPC_RADIO
	default y if DRYSPOOL_BLE_SETUP
