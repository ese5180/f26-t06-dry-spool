#include "../../mvp_firmware/boards/nrf7002dk_nrf5340_cpuapp.overlay"
/delete-node/ &slot1_partition;
&slot0_partition { reg = <0x10000 DT_SIZE_K(896)>; };
&mx25r64 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;
		slot1_partition: partition@0 {
			label = "image-1";
			reg = <0 DT_SIZE_K(896)>;
		};
	};
};
