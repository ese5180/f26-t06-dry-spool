#include "../../firmware/boards/nrf7002dk_nrf5340_cpuapp_ns.overlay"

/* MCUboot slot 1 occupies 0..0xe0000. Store the version-matched NCS
 * Wi-Fi microcode separately, so replacing slot 1 cannot erase it. */
&mx25r64 {
	partitions {
		nrf70_wifi_fw_partition: nrf70_fw_partition: partition@100000 {
			label = "nrf70-firmware";
			reg = <0x100000 DT_SIZE_K(128)>;
		};
	};
};
